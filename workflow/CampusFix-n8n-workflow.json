    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst issue = $('CampusFix AI Agent').first().json.output\n  .match(/Issue:\\s*(.*)/)?.[1]?.trim().toLowerCase();\n\nconst location = $('CampusFix AI Agent').first().json.output\n  .match(/Location:\\s*(.*)/)?.[1]?.trim().toLowerCase();\n\nconst duplicate = items.find(item => {\n  const dbIssue = (item.json.issue || '').trim().toLowerCase();\n  const dbLocation = (item.json.location || '').trim().toLowerCase();\n\n  return dbIssue === issue && dbLocation === location;\n});\n\nif (duplicate) {\n  return [{\n    json: {\n      ...duplicate.json,\n      isDuplicate: true\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    isDuplicate: false\n  }\n}];"
      },
